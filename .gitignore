# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js / vinext
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# auto-generated by wrangler types
cloudflare-env.d.ts
worker-configuration.d.ts

# vinext / vite
/dist/

# wrangler files
wrangler.jsonc
.wrangler
.dev.vars*
!.dev.vars.example

# build output
.open-next/

# editor
.vscode/

# agent / tool config
.agents/
.claude/
.kilo/
.kilocode/
.roo/
.vinext/

# npm/pnpm config (may contain registry tokens)
.npmrc

# security audit cache
.audit-cache/

/REFERENCE
